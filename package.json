{
  "name": "byteark-player-angular",
  "version": "1.1.1",
  "scripts": {
    "start": "npm-run-all clean --parallel lib:watch sample:start-waiton",
    "build": "run-s lib:build sample:build",
    "test": "run-p lib:test sample:test",
    "lib:build": "ng build byteark-player-angular",
    "lib:watch": "ng build byteark-player-angular --watch --configuration development",
    "lib:test": "ng test byteark-player-angular",
    "sample:start-waiton": "wait-on dist/byteark-player-angular/package.json && npm run sample:start",
    "sample:start": "ng serve sample",
    "sample:build": "ng build sample",
    "sample:watch": "ng build sample --watch --configuration development",
    "sample:test": "ng test sample",
    "clean": "rimraf dist",
    "serve:ssr:sample": "node dist/sample/server/server.mjs",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "update-changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "version": "npm run update-changelog && git add CHANGELOG.md",
    "lint": "ng lint"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@angular/animations": "^19.2.11",
    "@angular/common": "^19.2.16",
    "@angular/compiler": "^19.2.11",
    "@angular/core": "^19.2.11",
    "@angular/forms": "^19.2.11",
    "@angular/platform-browser": "^19.2.11",
    "@angular/platform-browser-dynamic": "^19.2.11",
    "@angular/platform-server": "^19.2.11",
    "@angular/router": "^19.2.11",
    "@angular/ssr": "^19.2.12",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.12",
    "@angular/cli": "^19.2.12",
    "@angular/compiler-cli": "^19.2.11",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.27.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/express": "^5.0.2",
    "@types/jasmine": "^5.1.8",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.15.21",
    "@types/video.js": "^7.3.58",
    "angular-eslint": "19.4.0",
    "autoprefixer": "^10.4.21",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "express": "^5.1.0",
    "husky": "^9.1.7",
    "jasmine-core": "^5.7.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.32.1",
    "wait-on": "^8.0.3"
  }
}
